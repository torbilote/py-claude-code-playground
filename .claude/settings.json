{
  "statusLine": {
    "type": "command",
    "command": "py .claude/statusline.py"
  },
  "enabledMcpjsonServers": ["delivery-copilot"],
  "permissions": {
    "allow": [
      "Bash(py -m pytest:*)",
      "Bash(py -m delivery_copilot.cli:*)",
      "mcp__delivery-copilot__list_engagements",
      "mcp__delivery-copilot__get_engagement",
      "mcp__delivery-copilot__list_open_risks"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_risk_glance.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_secrets.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit_log.py\""
          }
        ]
      }
    ]
  }
}
